@using CoreBusiness
@model Project_2026_MMP.ViewModels.SalesViewModel

@section title {
    <div class="row">
        <div class="col-7"><h3>Cashier's Console</h3></div>
        <div class="col-2"><label for="cashier">Cashier Name:</label></div>
        <div class="col-3">
            @User?.Identity?.Name
        </div>
    </div>
}

<br />
<div class="row">
    <div class="col-4">
        <div class="text-danger" id="validationSummary"></div>

        <select asp-for="SelectedCategoryId" class="form-control">
            <option value="">- Please Select -</option>
            @if (Model.Categories != null && Model.Categories.Any())
            {
                @foreach (var cat in Model.Categories)
                {
                    <option value="@cat.CategoryId">@cat.Name</option>
                }
            }
        </select>
        <br />
        <div id="productsPartial"></div>
        <br />
        <div id="productDetailPartial"></div>

        <form method="post" asp-controller="sales" asp-action="sell" id="formSale" style="display:none;">
            <input asp-for="SelectedProductId" type="hidden" />
            <div class="form-group">
                <label asp-for="QuantityToSell"></label>
                <input asp-for="QuantityToSell" class="form-control" type="number" min="1" />
            </div>
            <br />
            <div class="form-group">
                <input type="submit" class="btn btn-primary" value="Submit" />
            </div>
        </form>
    </div>
    <div class="col">
        <div id="transactionsPartial">
            @await Component.InvokeAsync("Transactions", "Cashier1")
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(function () {
            $("#QuantityToSell").val("");

            $("#SelectedCategoryId").on("change", function () {
                var categoryId = $(this).val();
                if (categoryId > 0) {
                    $("#productsPartial").load("/sales/ProductsByCategoryPartial", { categoryId: categoryId });
                    $("#productDetailPartial").html("");
                    $("#formSale").hide();
                }
            });

            $("#productsPartial").on('click', '.product-row', function () {
                $('.product-row').removeClass('highlight');
                $(this).addClass('highlight');

                var productId = $(this).attr('product-id');
                $("#productDetailPartial").load("/sales/SellProductPartial", { productId: productId });

                if (productId > 0) {
                    $("#SelectedProductId").val(productId);
                    $("#formSale").show();
                }
            });

            $("#formSale").on("submit", function (e) {
                e.preventDefault();
                var form = $(this);

                $.post(form.attr("action"), form.serialize())
                    .done(function () {
                        
                        $("#transactionsPartial").load("/sales/GetTransactionsPartial?cashierName=Cashier1");
                        var categoryId = $("#SelectedCategoryId").val();
                        $("#productsPartial").load("/sales/ProductsByCategoryPartial", { categoryId: categoryId });

                        
                        $("#QuantityToSell").val("");
                        $("#productDetailPartial").html("");
                        form.hide();
                        $("#validationSummary").text("");
                    })
                    .fail(function (xhr) {
                        
                        $("#validationSummary").text(xhr.responseText);
                    });
            });
        });
    </script>
}