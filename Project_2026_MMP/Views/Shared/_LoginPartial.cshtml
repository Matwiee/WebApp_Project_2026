@using Microsoft.AspNetCore.Identity
@using Project_2026_MMP.Data
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<ul class="navbar-nav">
    @if (SignInManager.IsSignedIn(User))
    {
        <li class="nav-item d-flex align-items-center me-3">
            <a class="nav-link p-0" asp-area="Identity" asp-page="/Account/Manage/Index" title="Manage" style="font-size: 0.85rem;">
                HELLO @User.Identity?.Name!.ToUpper()
            </a>
        </li>
        <li class="nav-item">
            <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                <button type="submit" class="nav-link btn btn-link py-0" style="font-weight: bold; text-transform: uppercase;">Logout</button>
            </form>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="nav-link btn-menu d-flex flex-column align-items-center me-3" asp-area="Identity" asp-page="/Account/Login" style="color: white !important;">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" class="bi bi-person" viewBox="0 0 16 16">
                    <path d="M8 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6m2-3a2 2 0 1 1-4 0 2 2 0 0 1 4 0m4 8c0 1-1 1-1 1H3s-1 0-1-1 1-4 6-4 6 3 6 4m-1-.004c-.001-.246-.154-.986-.832-1.664C11.516 10.68 10.289 10 8 10s-3.516.68-4.168 1.332c-.678.678-.83 1.418-.832 1.664z" />
                </svg>
                <span class="menu-text text-uppercase" style="font-size: 0.7rem; margin-top: 2px;">Sign In</span>
            </a>
        </li>
    }
</ul>